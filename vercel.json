{
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 20 * * *"
    }
  ],
  "functions": {
    "api/ingest.js": {
      "maxDuration": 60
    },
    "api/company-profile.js": {
      "maxDuration": 60
    },
    "api/account-chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
