<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — copy to ~/Library/LaunchAgents/com.sdrdashboard.last30days-sync.plist
  and replace every REPLACE_ME before loading. See scripts/local/README.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdrdashboard.last30days-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_ME_NODE_PATH</string>
        <!-- e.g. /usr/local/bin/node or /opt/homebrew/bin/node — run `which node` to find yours -->
        <string>REPLACE_ME_REPO_PATH/scripts/local/sync-last30days.mjs</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DATABASE_URL</key>
        <string>REPLACE_ME_DATABASE_URL</string>
        <key>DASHBOARD_URL</key>
        <string>https://sdr-dashboard-nu.vercel.app</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:REPLACE_ME_CLAUDE_CLI_DIR</string>
        <!-- claude must be resolvable on this PATH — launchd does not read your shell's PATH -->
    </dict>

    <!--
      Fires daily at 09:00 local time. Vercel's ingest cron runs at 20:00 UTC.
      Convert 20:00 UTC to your local timezone and make sure this Hour is
      comfortably after it (a few hours of buffer, not back-to-back) — if
      this fires before that day's ingest has landed, it'll see yesterday's
      data and find nothing new to research.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>REPLACE_ME_HOME/Library/Logs/sdr-dashboard-last30days.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_ME_HOME/Library/Logs/sdr-dashboard-last30days-error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
