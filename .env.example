# Copy this file to .env.local for local development, or set these in your
# Vercel project's Environment Variables for a real deploy.
# Full walkthrough: see README.md "One-time setup".

# --- Required ---

# Neon/Postgres connection string. Auto-filled by Vercel if you connect a
# Neon database via Storage -> Connect Database. For local dev, run
# `vercel env pull .env.local` after that instead of setting it by hand.
DATABASE_URL=

# console.anthropic.com. Powers the ingest pipeline's article normalization.
# Spend is capped at $10/month by default — see api/_lib/budget.js.
ANTHROPIC_API_KEY=

# Any random string you generate yourself (e.g. `openssl rand -hex 32`).
# Vercel sends this automatically as the cron job's Authorization header;
# you only need to set the value here.
CRON_SECRET=

# Required to serve the dashboard at all when self-hosting outside Vercel's
# own auth (see server/index.mjs and HOSTING.md). Pick your own password.
DASHBOARD_PASSWORD=

# --- Optional ---

# HTTP basic auth username paired with DASHBOARD_PASSWORD. Defaults to "sdr".
DASHBOARD_USER=

# Only needed if you want live market-data signals for US-listed tickers.
# Get a free key at finnhub.io. Leave unset to skip that signal type.
FINNHUB_API_KEY=

# Google News locale for the ingest pipeline, as "hl:gl:ceid". Defaults to
# "en-US:US:US". Example for Australia: "en-AU:AU:AU".
NEWS_LOCALE=

# Self-hosting only (ignored on Vercel). Defaults: HOST=0.0.0.0, PORT=3000.
HOST=
PORT=
